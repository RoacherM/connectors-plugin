{
  "name": "@local/dsh-connectors",
  "version": "0.1.0",
  "description": "Connectors for DSH: MCP servers (remote with OAuth, or local stdio) and a built-in email connector (Gmail/IMAP), exposed to the agent as tools",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/host.js",
    "./client": "./client.js"
  },
  "files": [
    "dist/host.js",
    "client.js",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test --test-force-exit test/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "esbuild": "^0.28.2",
    "imapflow": "^1.0.0",
    "jsdom": "^30.1.1",
    "mailparser": "^3.7.0",
    "nodemailer": "^7.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^3.25.0"
  }
}
